APP_NAME=DaloWeb
APP_ENV=production
APP_KEY=base64:7lHRVeubn3NfhPN4+cMM2xl2KapvcbO9X5lEh5XeeW8=
APP_DEBUG=false
APP_URL=https://www.daloweb.es
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daloweb
DB_USERNAME=
DB_PASSWORD=

# Archivos locales: la portada no depende de la conexión a la BD.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Completar con las credenciales SMTP del hosting.
# Puerto 587: MAIL_SCHEME=smtp (STARTTLS); puerto 465: smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hola@daloweb.es
MAIL_FROM_NAME="${APP_NAME}"
